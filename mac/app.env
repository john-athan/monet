# Build settings tools/build-app.sh and tools/test.sh read. Name, executable,
# identifier and version live in Info.plist and nowhere else.
FRAMEWORKS="Cocoa SwiftUI Photos Vision CryptoKit WebKit Security ServiceManagement CoreServices IOKit Speech AVFoundation"
SWIFTC_FLAGS="-swift-version 5"
LINK_FLAGS="-lsqlite3"
RESOURCES="Resources/*.png"
