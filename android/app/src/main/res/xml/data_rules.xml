<?xml version="1.0" encoding="utf-8"?>
<!-- The device token and the hash table belong to this phone and this pairing: never into a backup. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
