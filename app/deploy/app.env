# What oss-kit's deploy.sh, install.sh and nginx.sh read; keys are in deploy/README.md.
NAME=monet
HOST_NAME=monet.kaleve.dev
PORT=4320
NGINX_PORT=8446
SSH_HOST=kaleve-home
# models (fetched on the Mac by tools/fetch-models.ts) reach the server before it restarts: it starts the OCR worker at once
SYNC="models:/var/lib/monet/models"
SERVICE_USER=monet
PUBLIC_URL=https://monet.kaleve.dev/healthz
PUBLIC_EXPECT=200
PASSKEYS=yes
